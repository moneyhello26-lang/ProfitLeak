DATABASE_URL=sqlite:///backend/profitleak.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
IMPORT_SIGNING_KEY=profitleak-local-demo-change-before-deployment
IMPORT_TOKEN_TTL_SECONDS=900
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Optional: serve the production frontend from FastAPI on the same origin.
# FRONTEND_DIST=C:/absolute/path/to/ProfitLeak/frontend/dist

LLM_ENABLED=true
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=25
LLM_MAX_OUTPUT_TOKENS=600
LLM_HISTORY_MESSAGES=4
LLM_CACHE_TTL_SECONDS=600
